# saas-identity-platform-go 运行环境变量全集（.env / .env.test 的键集合须与此严格相等，L0.5 env 门巡检）。
# 缺键 fail-fast（suite-hard-rules §1），禁止代码里写默认值兜底。
# SERVER_PORT 是 multi-repo-family §6 全家族统一 key（X04-X10 同款）。
SERVER_PORT=5111

# —— Database（dev 链连 saas_dev；测试链由 .env.test 覆盖为 saas_test） ——
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54321/saas_dev

# —— JWT (HS256, ≥32B 硬约束, 全家族镜像同一 JWT_SIGNING_KEY) ——
JWT_SIGNING_KEY=dev-key-32-bytes-minimum-length!
JWT_ISSUER=saas-identity-platform
JWT_AUDIENCE=saas-identity-platform-clients
JWT_TTL_SECONDS=3600
